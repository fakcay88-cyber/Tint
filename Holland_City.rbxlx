local Config = {}
Config.Name = &quot;Holland City&quot;
Config.Version = &quot;0.1.0&quot;
Config.StartCoins = 100
Config.WorkSeconds = 8
Config.WorkCooldown = 20
Config.MaxCoins = 999999
Config.Roles = {
    {id=&quot;inwoner&quot;, name=&quot;Inwoner&quot;, task=&quot;Bedenk je eigen verhaal&quot;, reward=0},
    {id=&quot;bakker&quot;, name=&quot;Snoepbakker&quot;, task=&quot;Versier een doos snoep in SweetCity&quot;, reward=25},
    {id=&quot;winkel&quot;, name=&quot;Winkelmedewerker&quot;, task=&quot;Vul de schappen bij Buurtmarkt&quot;, reward=20},
    {id=&quot;politie&quot;, name=&quot;Wijkagent&quot;, task=&quot;Maak een verkeersbord klaar bij het bureau&quot;, reward=20},
    {id=&quot;boer&quot;, name=&quot;Boer&quot;, task=&quot;Pak een groentekrat op de boerderij&quot;, reward=25},
    {id=&quot;barista&quot;, name=&quot;Barista&quot;, task=&quot;Maak een bestelling bij Grachtenkoffie&quot;, reward=20},
    {id=&quot;monteur&quot;, name=&quot;Fietsenmaker&quot;, task=&quot;Controleer een fiets bij de werkplaats&quot;, reward=25},
}
Config.RoleById = {}
for _, role in ipairs(Config.Roles) do Config.RoleById[role.id] = role end
Config.Destinations = {
    {id=&quot;zwanenburg&quot;, name=&quot;Zwanenburg&quot;, description=&quot;Wonen, buurtmarkt en speelplein&quot;, x=-160, z=120},
    {id=&quot;halfweg&quot;, name=&quot;Halfweg / SweetCity&quot;, description=&quot;Snoepfabriek en vrolijke silo's&quot;, x=-160, z=-115},
    {id=&quot;amsterdam&quot;, name=&quot;Amsterdam&quot;, description=&quot;Grachten, koffie en wijkbureau&quot;, x=240, z=120},
    {id=&quot;polders&quot;, name=&quot;De polders&quot;, description=&quot;Molen, boerderij en bloemen&quot;, x=-200, z=320},
}
Config.DestinationById = {}
for _, place in ipairs(Config.Destinations) do Config.DestinationById[place.id] = place end
Config.Themes = {
    {id=&quot;gezellig&quot;, name=&quot;Gezellig&quot;, price=0, rgb={216, 140, 87}},
    {id=&quot;mint&quot;, name=&quot;Mint&quot;, price=50, rgb={95, 187, 153}},
    {id=&quot;pastel&quot;, name=&quot;Pastel&quot;, price=50, rgb={211, 145, 187}},
    {id=&quot;zee&quot;, name=&quot;Zee&quot;, price=50, rgb={92, 157, 205}},
}
Config.ThemeById = {}
for _, theme in ipairs(Config.Themes) do Config.ThemeById[theme.id] = theme end
Config.Vehicles = {
    {id=&quot;bakfiets&quot;, name=&quot;Bakfiets&quot;, speed=28, color={41,174,151}},
    {id=&quot;auto&quot;, name=&quot;Stadsauto&quot;, speed=42, color={242,156,66}},
    {id=&quot;tractor&quot;, name=&quot;Tractor&quot;, speed=24, color={92,160,80}},
}
Config.VehicleById = {}
for _, vehicle in ipairs(Config.Vehicles) do Config.VehicleById[vehicle.id] = vehicle end
return Config
</ProtectedString></Properties></Item><Item class="Folder" referent="RBX1506"><Properties><string name="Name">Network</string></Properties><Item class="RemoteEvent" referent="RBX1507"><Properties><string name="Name">Action</string></Properties></Item><Item class="RemoteEvent" referent="RBX1508"><Properties><string name="Name">Notice</string></Properties></Item><Item class="RemoteEvent" referent="RBX1509"><Properties><string name="Name">Drive</string></Properties></Item></Item></Item></Item><Item class="ServerScriptService" referent="RBX1510"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="ModuleScript" referent="RBX1511"><Properties><string name="Name">Rules</string><ProtectedString name="Source">-- Pure game rules; deliberately also valid Lua 5.3 for offline unit tests.
-- Server is the only authority for money, ownership, roles and rewards.
local Rules = {}
function Rules.new(config)
    return {coins=config.StartCoins, role=&quot;inwoner&quot;, house=nil, themes={gezellig=true},
        theme=&quot;gezellig&quot;, busy=nil, nextWork=0, rate={}, vehicle=nil}
end
function Rules.allow(state, key, now, seconds)
    if now &lt; (state.rate[key] or -math.huge) then return false end
    state.rate[key] = now + seconds
    return true
end
function Rules.role(state, id, config)
    if type(id) ~= &quot;string&quot; or not config.RoleById[id] then return false, &quot;Onbekende rol.&quot; end
    if state.busy then return false, &quot;Rond eerst je taak af.&quot; end
    state.role = id
    return true, &quot;Je bent nu &quot; .. config.RoleById[id].name .. &quot;.&quot;
end
function Rules.claim(state, house, userId)
    if state.house == house.id then return false, &quot;Dit is al jouw huis.&quot; end
    if house.owner then return false, &quot;Dit huis is al bewoond.&quot; end
    if state.house then return false, &quot;Geef eerst je huidige huis vrij via Huis.&quot; end
    house.owner, house.locked, state.house = userId, false, house.id
    return true, &quot;Dit huis is van jou zolang je in deze server blijft!&quot;
end
function Rules.release(state, house, userId)
    if not house or house.owner ~= userId then return false, &quot;Je hebt hier geen huis.&quot; end
    house.owner, house.locked, state.house = nil, false, nil
    return true, &quot;Je huis is weer vrij.&quot;
end
function Rules.theme(state, id, config)
    local theme = type(id)==&quot;string&quot; and config.ThemeById[id]
    if not theme then return false, &quot;Onbekende stijl.&quot; end
    if not state.house then return false, &quot;Kies eerst een vrij huis.&quot; end
    if not state.themes[id] then
        if state.coins &lt; theme.price then return false, &quot;Je hebt nog niet genoeg speelmunten.&quot; end
        state.coins = state.coins - theme.price
        state.themes[id] = true
    end
    state.theme = id
    return true, &quot;Woonstijl toegepast.&quot;
end
function Rules.startWork(state, roleId, now, config)
    local role = config.RoleById[roleId]
    if not role or role.reward &lt;= 0 or state.role ~= roleId then return false, &quot;Kies eerst de juiste rol via Rollen.&quot; end
    if state.busy then return false, &quot;Je bent al bezig met een taak.&quot; end
    if now &lt; state.nextWork then return false, &quot;Je volgende taak is over &quot; .. math.ceil(state.nextWork-now) .. &quot; sec. klaar.&quot; end
    state.busy = {role=roleId, finish=now+config.WorkSeconds}
    return true, &quot;Blijf &quot; .. config.WorkSeconds .. &quot; seconden bij je werkplek.&quot;
end
function Rules.finishWork(state, now, validPosition, config)
    local work = state.busy
    if not work or now &lt; work.finish then return false, &quot;Nog niet klaar.&quot; end
    state.busy = nil
    if not validPosition or state.role ~= work.role then return false, &quot;Taak gestopt: je verliet je werkplek.&quot; end
    state.nextWork = now + config.WorkCooldown
    state.coins = math.min(config.MaxCoins, state.coins + config.RoleById[work.role].reward)
    return true, &quot;+&quot; .. config.RoleById[work.role].reward .. &quot; speelmunten!&quot;
end
function Rules.validDrive(throttle, steer)
    return type(throttle)==&quot;number&quot; and type(steer)==&quot;number&quot;
        and throttle==throttle and steer==steer
        and math.abs(throttle)&lt;=1 and math.abs(steer)&lt;=1
end
return Rules
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX1512"><Properties><string name="Name">Vehicles</string><ProtectedString name="Source">-- Arcade vehicles: anchored, server-controlled models on flat ground.
-- No vehicle damage, no player damage, one vehicle per player.
local Vehicles = {}
local RunService = game:GetService(&quot;RunService&quot;)
local Players = game:GetService(&quot;Players&quot;)
local active = {}
local folder = Instance.new(&quot;Folder&quot;)
folder.Name = &quot;HollandVehicles&quot;
folder.Parent = workspace

local function part(model, name, size, cf, color, class)
    local p = Instance.new(class or &quot;Part&quot;)
    p.Name, p.Size, p.CFrame, p.Color = name, size, cf, color
    p.Anchored, p.CanCollide = true, false
    p.Material = Enum.Material.SmoothPlastic
    p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
    p.Parent = model
    return p
end
function Vehicles.remove(player)
    local car = active[player]
    if not car then return end
    active[player] = nil
    if car.seat.Occupant then car.seat.Occupant.Sit = false end
    car.model:Destroy()
    player:SetAttribute(&quot;Driving&quot;, false)
end
function Vehicles.spawn(player, definition, spawnCF)
    Vehicles.remove(player)
    local model = Instance.new(&quot;Model&quot;)
    model.Name = definition.name
    model:SetAttribute(&quot;OwnerUserId&quot;, player.UserId)
    local color = Color3.fromRGB(table.unpack(definition.color))
    local base = spawnCF
    local bike = definition.id == &quot;bakfiets&quot;
    local tractor = definition.id == &quot;tractor&quot;
    local width = bike and 3.4 or 5.8
    local chassis = part(model, &quot;Chassis&quot;, Vector3.new(width, .7, 8), base, color)
    model.PrimaryPart = chassis
    local seat = part(model, &quot;Driver&quot;, Vector3.new(2, .5, 2), base*CFrame.new(0, .7, 1.6), Color3.fromRGB(39,50,60), &quot;Seat&quot;)
    -- Sit is intentional, so players cannot accidentally take another player's seat.
    seat.Disabled = true
    if bike then
        part(model,&quot;Bak&quot;,Vector3.new(3.4,1.7,3.6),base*CFrame.new(0,1.1,-1.7),Color3.fromRGB(209,168,111))
        part(model,&quot;Stuur&quot;,Vector3.new(3,.25,.25),base*CFrame.new(0,2.2,.3),Color3.fromRGB(45,55,66))
    else
        part(model,&quot;Motorkap&quot;,Vector3.new(width,1.3,3.4),base*CFrame.new(0,.9,-2),color)
        part(model,&quot;Achterkant&quot;,Vector3.new(width,1.2,1.3),base*CFrame.new(0,.8,3.3),color)
        if not tractor then
            part(model,&quot;Dak&quot;,Vector3.new(width,.35,4.3),base*CFrame.new(0,3.5,.8),color)
            for _,x in ipairs({-width/2+.2,width/2-.2}) do
                part(model,&quot;Dakstijl&quot;,Vector3.new(.3,3,.3),base*CFrame.new(x,2,-1),color)
                part(model,&quot;Dakstijl&quot;,Vector3.new(.3,3,.3),base*CFrame.new(x,2,2.8),color)
            end
        end
    end
    for _,x in ipairs({-width/2,width/2}) do
        for _,z in ipairs({-2.4,2.6}) do
            local diameter = tractor and z&gt;0 and 3.5 or 2.2
            local wheel = part(model,&quot;Wiel&quot;,Vector3.new(.65,diameter,diameter),base*CFrame.new(x,-.1,z),Color3.fromRGB(35,42,49))
            wheel.Shape = Enum.PartType.Cylinder
        end
    end
    for _,x in ipairs({-width/3,width/3}) do
        local lamp=part(model,&quot;Koplamp&quot;,Vector3.new(.7,.4,.15),base*CFrame.new(x,.8,-4.05),Color3.fromRGB(255,244,180))
        lamp.Material=Enum.Material.Neon
    end
    local prompt = Instance.new(&quot;ProximityPrompt&quot;)
    prompt.ActionText, prompt.ObjectText = &quot;Instappen&quot;, definition.name
    prompt.RequiresLineOfSight, prompt.MaxActivationDistance = false, 10
    prompt.Parent = chassis
    local data = {model=model,seat=seat,throttle=0,steer=0,inputAt=0,lastInput=-100,
        speed=definition.speed,width=width,parkedAt=os.clock(),owner=player}
    active[player] = data
    model.Parent = folder
    prompt.Triggered:Connect(function(who)
        local char=who.Character
        local root=char and char:FindFirstChild(&quot;HumanoidRootPart&quot;)
        local hum=char and char:FindFirstChildOfClass(&quot;Humanoid&quot;)
        if who~=player or not root or not hum or hum.Health&lt;=0 or hum.SeatPart
            or (root.Position-chassis.Position).Magnitude&gt;12 then return end
        seat.Disabled=false
        seat:Sit(hum)
    end)
    seat:GetPropertyChangedSignal(&quot;Occupant&quot;):Connect(function()
        local hum=seat.Occupant
        if hum and Players:GetPlayerFromCharacter(hum.Parent)~=player then hum.Sit=false; return end
        player:SetAttribute(&quot;Driving&quot;, hum~=nil)
        data.throttle, data.steer=0,0
        if not hum then seat.Disabled=true; data.parkedAt=os.clock() end
    end)
    return true
end
function Vehicles.input(player, throttle, steer)
    local car=active[player]
    if not car or not car.seat.Occupant or car.seat.Occupant.Parent~=player.Character then return end
    local now=os.clock()
    if now-car.lastInput&lt;.045 then return end
    car.lastInput,car.inputAt,car.throttle,car.steer=now,now,throttle,steer
end
function Vehicles.exit(player)
    local car=active[player]
    if not car then return end
    car.throttle,car.steer=0,0
    if car.seat.Occupant then car.seat.Occupant.Sit=false end
end
function Vehicles.has(player) return active[player]~=nil end
RunService.Heartbeat:Connect(function(dt)
    dt=math.min(dt,.05)
    for player, car in pairs(active) do
        if not player.Parent or not car.model.Parent then Vehicles.remove(player)
        elseif not car.seat.Occupant then
            if os.clock()-car.parkedAt&gt;180 then Vehicles.remove(player) end
        elseif os.clock()-car.inputAt&lt;.5 and math.abs(car.throttle)&gt;.01 then
            local cf=car.model:GetPivot()
            local turn=-car.steer*1.4*dt*(car.throttle&gt;=0 and 1 or -1)
            local nextCF=cf*CFrame.Angles(0,turn,0)
            local delta=nextCF.LookVector*car.speed*car.throttle*dt
            local params=RaycastParams.new()
            params.FilterType=Enum.RaycastFilterType.Exclude
            params.FilterDescendantsInstances={car.model,player.Character}
            params.RespectCanCollide=true
            local obstruction=workspace:Blockcast(cf+Vector3.new(0,1.3,0),Vector3.new(car.width+.3,2.8,8.4),delta,params)
            local ground=workspace:Raycast(cf.Position+delta+Vector3.new(0,3,0),Vector3.new(0,-8,0),params)
            local newPos=cf.Position+delta
            if not obstruction and ground and ground.Position.Y&gt;=-.1 and ground.Position.Y&lt;=1.5
                and math.abs(newPos.X)&lt;455 and newPos.Z&gt;-250 and newPos.Z&lt;490 then
                -- Never push players: all vehicle visuals are non-colliding.
                car.model:PivotTo(CFrame.new(newPos.X,ground.Position.Y+1.65,newPos.Z)*nextCF.Rotation)
            end
        end
    end
end)
Players.PlayerRemoving:Connect(Vehicles.remove)
return Vehicles
</ProtectedString></Properties></Item><Item class="Script" referent="RBX1513"><Properties><string name="Name">HollandServer</string><ProtectedString name="Source">-- Holland City | Server-authoritative prototype. Session-only progress.
local Players=game:GetService(&quot;Players&quot;)
local ReplicatedStorage=game:GetService(&quot;ReplicatedStorage&quot;)
local Lighting=game:GetService(&quot;Lighting&quot;)
local shared=ReplicatedStorage:WaitForChild(&quot;HollandCity&quot;)
local Config=require(shared:WaitForChild(&quot;Config&quot;))
local Rules=require(script.Parent:WaitForChild(&quot;Rules&quot;))
local Vehicles=require(script.Parent:WaitForChild(&quot;Vehicles&quot;))
local network=shared:WaitForChild(&quot;Network&quot;)
local action,notice,drive=network.Action,network.Notice,network.Drive
local world=workspace:WaitForChild(&quot;HollandCity&quot;)
local states,houses={},{}

local function value(object,name)
    local v=object:FindFirstChild(name)
    return v and v.Value
end
local function character(player)
    local char=player.Character
    local root=char and char:FindFirstChild(&quot;HumanoidRootPart&quot;)
    local hum=char and char:FindFirstChildOfClass(&quot;Humanoid&quot;)
    if root and hum and hum.Health&gt;0 then return char,root,hum end
end
local function nearby(player,part,range)
    local _,root=character(player)
    return root and (root.Position-part.Position).Magnitude&lt;=range
end
local function tell(player,message,kind)
    if player.Parent==Players then notice:FireClient(player,kind or &quot;message&quot;,message) end
end
local function sync(player)
    local state=states[player]
    if not state then return end
    local stats=player:FindFirstChild(&quot;leaderstats&quot;)
    if stats then
        stats.Munten.Value=state.coins
        stats.Rol.Value=Config.RoleById[state.role].name
    end
    player:SetAttribute(&quot;Role&quot;,state.role)
    player:SetAttribute(&quot;House&quot;,state.house or &quot;&quot;)
    player:SetAttribute(&quot;Theme&quot;,state.theme)
    player:SetAttribute(&quot;Working&quot;,state.busy~=nil)
    for _,theme in ipairs(Config.Themes) do player:SetAttribute(&quot;Theme_&quot;..theme.id,state.themes[theme.id]==true) end
end
local function paintHouse(house,themeId)
    local rgb=Config.ThemeById[themeId].rgb
    for _,part in ipairs(house.model:GetDescendants()) do
        if part:IsA(&quot;BasePart&quot;) and part.Name==&quot;Accent&quot; then part.Color=Color3.fromRGB(table.unpack(rgb)) end
    end
end
local function updateHouse(house)
    local plate=house.model:FindFirstChild(&quot;Claim&quot;)
    local label=plate and plate:FindFirstChildWhichIsA(&quot;SurfaceGui&quot;)
    label=label and label:FindFirstChildWhichIsA(&quot;TextLabel&quot;)
    if label then label.Text=house.id..&quot;\n&quot;..(house.owner and &quot;BEWOOND&quot; or &quot;GRATIS HUIS&quot;) end
    local door=house.model:FindFirstChild(&quot;Door&quot;)
    -- Unoccupied homes stay freely accessible.
    if not house.owner and door then door.CanCollide=true; door.Transparency=.1 end
end
for _,model in ipairs(world.Houses:GetChildren()) do
    houses[model.Name]={id=model.Name,model=model,owner=nil,locked=false}
end
local function teleport(player,target)
    local char,_,hum=character(player)
    if not char then return end
    Vehicles.remove(player)
    hum.Sit=false
    task.delay(.15,function()
        if player.Character==char and hum.Health&gt;0 then
            char:PivotTo(target)
            local root=char:FindFirstChild(&quot;HumanoidRootPart&quot;)
            if root then root.AssemblyLinearVelocity=Vector3.zero; root.AssemblyAngularVelocity=Vector3.zero end
        end
    end)
end
local function onCharacter(player,char)
    local head=char:WaitForChild(&quot;Head&quot;,10)
    local hum=char:WaitForChild(&quot;Humanoid&quot;,10)
    if not head or not hum or not states[player] then return end
    hum.WalkSpeed=18
    Vehicles.remove(player)
    local board=Instance.new(&quot;BillboardGui&quot;)
    board.Name=&quot;HollandRole&quot;
    board.Size=UDim2.fromOffset(160,28)
    board.StudsOffset=Vector3.new(0,2.5,0)
    board.MaxDistance=65
    board.Parent=head
    local label=Instance.new(&quot;TextLabel&quot;)
    label.Size=UDim2.fromScale(1,1)
    label.BackgroundTransparency=1
    label.TextColor3=Color3.fromRGB(255,247,220)
    label.TextStrokeTransparency=.4
    label.TextSize=16
    label.Font=Enum.Font.GothamBold
    label.Text=Config.RoleById[states[player].role].name
    label.Parent=board
end
local function added(player)
    if states[player] then return end
    states[player]=Rules.new(Config)
    local stats=Instance.new(&quot;Folder&quot;); stats.Name=&quot;leaderstats&quot;; stats.Parent=player
    local coins=Instance.new(&quot;IntValue&quot;); coins.Name=&quot;Munten&quot;; coins.Parent=stats
    local role=Instance.new(&quot;StringValue&quot;); role.Name=&quot;Rol&quot;; role.Parent=stats
    sync(player)
    player:SetAttribute(&quot;Driving&quot;,false)
    player.CharacterAdded:Connect(function(char) onCharacter(player,char) end)
    if player.Character then task.spawn(onCharacter,player,player.Character) end
end
Players.PlayerAdded:Connect(added)
for _,player in ipairs(Players:GetPlayers()) do added(player) end
Players.PlayerRemoving:Connect(function(player)
    local state=states[player]
    if state and state.house then
        local house=houses[state.house]
        Rules.release(state,house,player.UserId)
        paintHouse(house,&quot;gezellig&quot;)
        updateHouse(house)
    end
    states[player]=nil
end)

local function spawnVehicle(player,id)
    local definition=type(id)==&quot;string&quot; and Config.VehicleById[id]
    if not definition then return end
    local _,root,hum=character(player)
    if not root or hum.SeatPart then tell(player,&quot;Stap eerst uit je voertuig.&quot;); return end
    local nearest,distance=nil,math.huge
    for _,pad in ipairs(world.VehiclePads:GetChildren()) do
        local d=(root.Position-pad.Position).Magnitude
        if d&lt;distance then nearest,distance=pad,d end
    end
    if not nearest or distance&gt;100 then tell(player,&quot;Loop naar een P-parkeerplaats bij een halte om een voertuig te pakken.&quot;); return end
    local overlap=OverlapParams.new()
    overlap.FilterType=Enum.RaycastFilterType.Exclude
    overlap.FilterDescendantsInstances={player.Character,world}
    local blocked=workspace:GetPartBoundsInBox(nearest.CFrame+Vector3.new(0,3,0),Vector3.new(9,5,13),overlap)
    for _,hit in ipairs(blocked) do
        if hit:IsDescendantOf(workspace.HollandVehicles) then
            local model=hit:FindFirstAncestorOfClass(&quot;Model&quot;)
            if model and model:GetAttribute(&quot;OwnerUserId&quot;)~=player.UserId then
                tell(player,&quot;De parkeerplaats is bezet. Probeer straks opnieuw.&quot;); return
            end
        elseif hit:FindFirstAncestorOfClass(&quot;Model&quot;) then
            tell(player,&quot;Er staat iemand op de parkeerplaats.&quot;); return
        end
    end
    Vehicles.spawn(player,definition,nearest.CFrame+Vector3.new(0,1.7,0))
    tell(player,&quot;Je &quot;..definition.name..&quot; staat op de P-plek. Loop erheen en kies Instappen.&quot;)
end

action.OnServerEvent:Connect(function(player,kind,id)
    local state=states[player]
    if not state or type(kind)~=&quot;string&quot; or #kind&gt;24 then return end
    if id~=nil and (type(id)~=&quot;string&quot; or #id&gt;40) then return end
    if not Rules.allow(state,&quot;action&quot;,os.clock(),.25) then return end
    local ok,msg
    if kind==&quot;role&quot; then
        ok,msg=Rules.role(state,id,Config)
        if ok and player.Character then
            local head=player.Character:FindFirstChild(&quot;Head&quot;)
            local board=head and head:FindFirstChild(&quot;HollandRole&quot;)
            if board then board.TextLabel.Text=Config.RoleById[id].name end
        end
    elseif kind==&quot;travel&quot; then
        local destination=Config.DestinationById[id]
        local marker=destination and world.Destinations:FindFirstChild(id)
        if marker and Rules.allow(state,&quot;travel&quot;,os.clock(),3) then
            state.busy=nil
            teleport(player,marker.CFrame+Vector3.new(0,3,0))
            msg=&quot;Welkom in &quot;..destination.name..&quot;!&quot;
        end
    elseif kind==&quot;theme&quot; then
        ok,msg=Rules.theme(state,id,Config)
        if ok then paintHouse(houses[state.house],id) end
    elseif kind==&quot;release&quot; then
        local house=state.house and houses[state.house]
        ok,msg=Rules.release(state,house,player.UserId)
        if ok then paintHouse(house,&quot;gezellig&quot;); updateHouse(house) end
    elseif kind==&quot;lock&quot; then
        local house=state.house and houses[state.house]
        if house and house.owner==player.UserId then
            house.locked=not house.locked
            local door=house.model.Door
            if house.locked then door.CanCollide=true; door.Transparency=.1 end
            msg=house.locked and &quot;De voordeur is op slot. Wie binnen is kan altijd naar buiten.&quot; or &quot;Je voordeur is niet meer op slot.&quot;
        else msg=&quot;Kies eerst een vrij huis.&quot; end
    elseif kind==&quot;home&quot; then
        local house=state.house and houses[state.house]
        if house then state.busy=nil; teleport(player,house.model.Entrance.CFrame+Vector3.new(0,3,0))
        else msg=&quot;Kies eerst een vrij huis in Zwanenburg.&quot; end
    elseif kind==&quot;vehicle&quot; then
        if Rules.allow(state,&quot;vehicle&quot;,os.clock(),3) then spawnVehicle(player,id) end
    elseif kind==&quot;removeVehicle&quot; then Vehicles.remove(player)
    elseif kind==&quot;exit&quot; then Vehicles.exit(player)
    end
    sync(player)
    if msg then tell(player,msg) end
end)
drive.OnServerEvent:Connect(function(player,throttle,steer)
    if Rules.validDrive(throttle,steer) then Vehicles.input(player,throttle,steer) end
end)

for _,part in ipairs(world:GetDescendants()) do
    if part:IsA(&quot;BasePart&quot;) and value(part,&quot;Action&quot;) then
        local kind=value(part,&quot;Action&quot;)
        local prompt=Instance.new(&quot;ProximityPrompt&quot;)
        prompt.ActionText=value(part,&quot;Prompt&quot;) or &quot;Gebruiken&quot;
        prompt.ObjectText=value(part,&quot;Title&quot;) or &quot;Holland City&quot;
        prompt.RequiresLineOfSight=false
        prompt.MaxActivationDistance=10
        prompt.HoldDuration=.35
        prompt.Parent=part
        prompt.Triggered:Connect(function(player)
            local state=states[player]
            if not state or not prompt.Enabled or not nearby(player,part,12)
                or not Rules.allow(state,&quot;prompt&quot;,os.clock(),.6) then return end
            local ok,msg
            if kind==&quot;claim&quot; then
                local house=houses[value(part,&quot;HouseId&quot;)]
                if house then
                    ok,msg=Rules.claim(state,house,player.UserId)
                    if ok then paintHouse(house,state.theme); updateHouse(house) end
                end
            elseif kind==&quot;door&quot; then
                local house=houses[value(part,&quot;HouseId&quot;)]
                local _,root=character(player)
                -- Local -Z is inside for every generated building; never trap guests.
                local inside=root and part.CFrame:PointToObjectSpace(root.Position).Z&lt;0
                if house and house.locked and house.owner~=player.UserId and not inside then
                    msg=&quot;Deze voordeur is op slot.&quot;
                else
                    part.CanCollide=not part.CanCollide
                    part.Transparency=part.CanCollide and .1 or .8
                end
            elseif kind==&quot;work&quot; then
                ok,msg=Rules.startWork(state,value(part,&quot;Role&quot;),os.clock(),Config)
                if ok then
                    local token=state.busy
                    task.delay(Config.WorkSeconds+.05,function()
                        if states[player]~=state or state.busy~=token then return end
                        local completed,message=Rules.finishWork(state,os.clock(),nearby(player,part,12),Config)
                        sync(player); tell(player,message)
                        if completed then
                            local light=Instance.new(&quot;PointLight&quot;)
                            light.Color=Color3.fromRGB(113,255,170); light.Brightness=2; light.Range=10; light.Parent=part
                            game:GetService(&quot;Debris&quot;):AddItem(light,1)
                        end
                    end)
                end
            elseif kind==&quot;travel&quot; then tell(player,&quot;&quot;,&quot;travel&quot;)
            elseif kind==&quot;vehicles&quot; then tell(player,&quot;&quot;,&quot;vehicles&quot;)
            elseif kind==&quot;info&quot; then tell(player,&quot;Kies een gratis huis, pak een voertuig of ga werken. Alles in dit prototype gebruikt speelmunten; geen Robux.&quot;)
            end
            sync(player)
            if msg then tell(player,msg) end
        end)
    end
end
-- Gentle daytime cycle. Water recovery is non-punitive, without drowning.
task.spawn(function()
    while true do
        task.wait(1)
        Lighting.ClockTime=9+(os.clock()/180)%8
        for player,state in pairs(states) do
            local _,root=character(player)
            if root and (root.Position.Y&lt;-.7 or math.abs(root.Position.X)&gt;480 or root.Position.Z&lt; -280 or root.Position.Z&gt;520) then
                state.busy=nil; sync(player)
                teleport(player,world.Destinations.zwanenburg.CFrame+Vector3.new(0,3,0))
                tell(player,&quot;We zetten je weer veilig op het plein.&quot;)
            end
        end
    end
end)
print(&quot;Holland City &quot;..Config.Version..&quot; ready. Prototype: voortgang is alleen voor deze sessie.&quot;)
</ProtectedString></Properties></Item></Item><Item class="StarterPlayer" referent="RBX1514"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX1515"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX1516"><Properties><string name="Name">HollandClient</string><ProtectedString name="Source">-- Holland City | Responsive Dutch interface; native Roblox chat stays untouched.
local Players=game:GetService(&quot;Players&quot;)
local ReplicatedStorage=game:GetService(&quot;ReplicatedStorage&quot;)
local UserInputService=game:GetService(&quot;UserInputService&quot;)
local RunService=game:GetService(&quot;RunService&quot;)
local ContextActionService=game:GetService(&quot;ContextActionService&quot;)
local player=Players.LocalPlayer
local shared=ReplicatedStorage:WaitForChild(&quot;HollandCity&quot;)
local Config=require(shared:WaitForChild(&quot;Config&quot;))
local network=shared:WaitForChild(&quot;Network&quot;)
local stats=player:WaitForChild(&quot;leaderstats&quot;)
stats:WaitForChild(&quot;Munten&quot;)
stats:WaitForChild(&quot;Rol&quot;)
local ink=Color3.fromRGB(26,46,60)
local teal=Color3.fromRGB(25,141,139)
local white=Color3.fromRGB(249,248,241)
local function make(class,parent,props)
    local obj=Instance.new(class)
    for key,v in pairs(props or {}) do obj[key]=v end
    obj.Parent=parent
    return obj
end
local function round(parent,r) make(&quot;UICorner&quot;,parent,{CornerRadius=UDim.new(0,r or 12)}) end
local gui=make(&quot;ScreenGui&quot;,player:WaitForChild(&quot;PlayerGui&quot;),{Name=&quot;HollandCityUI&quot;,ResetOnSpawn=false,IgnoreGuiInset=false,ZIndexBehavior=Enum.ZIndexBehavior.Sibling})
local hud=make(&quot;Frame&quot;,gui,{Position=UDim2.new(0,12,0,10),Size=UDim2.new(0,288,0,66),BackgroundColor3=ink,BorderSizePixel=0})
round(hud)
make(&quot;TextLabel&quot;,hud,{BackgroundTransparency=1,Position=UDim2.fromOffset(14,7),Size=UDim2.new(1,-28,0,25),Text=&quot;HOLLAND CITY&quot;,TextColor3=white,Font=Enum.Font.GothamBlack,TextSize=22,TextXAlignment=Enum.TextXAlignment.Left})
local status=make(&quot;TextLabel&quot;,hud,{BackgroundTransparency=1,Position=UDim2.fromOffset(14,35),Size=UDim2.new(1,-28,0,22),Text=&quot;&quot;,TextColor3=Color3.fromRGB(152,226,210),Font=Enum.Font.Gotham,TextSize=13,TextXAlignment=Enum.TextXAlignment.Left})
local nav=make(&quot;Frame&quot;,gui,{Position=UDim2.new(0,12,0,84),Size=UDim2.fromOffset(288,88),BackgroundTransparency=1})
make(&quot;UIGridLayout&quot;,nav,{CellSize=UDim2.fromOffset(140,38),CellPadding=UDim2.fromOffset(8,6),SortOrder=Enum.SortOrder.LayoutOrder})
local panel=make(&quot;Frame&quot;,gui,{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.5),Size=UDim2.new(1,-28,1,-30),BackgroundColor3=white,BorderSizePixel=0,Visible=false,ZIndex=5})
make(&quot;UISizeConstraint&quot;,panel,{MaxSize=Vector2.new(520,520),MinSize=Vector2.new(240,190)})
round(panel,16)
local heading=make(&quot;TextLabel&quot;,panel,{Position=UDim2.fromOffset(20,10),Size=UDim2.new(1,-76,0,36),BackgroundTransparency=1,Text=&quot;&quot;,TextColor3=ink,TextSize=22,Font=Enum.Font.GothamBold,TextXAlignment=Enum.TextXAlignment.Left,ZIndex=6})
local close=make(&quot;TextButton&quot;,panel,{AnchorPoint=Vector2.new(1,0),Position=UDim2.new(1,-12,0,12),Size=UDim2.fromOffset(34,34),Text=&quot;X&quot;,TextColor3=white,BackgroundColor3=ink,TextSize=16,Font=Enum.Font.GothamBold,ZIndex=6})
round(close,9)
close.Activated:Connect(function() panel.Visible=false end)
local content=make(&quot;ScrollingFrame&quot;,panel,{Position=UDim2.fromOffset(16,58),Size=UDim2.new(1,-32,1,-74),BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=5,AutomaticCanvasSize=Enum.AutomaticSize.Y,CanvasSize=UDim2.new(),ZIndex=6})
make(&quot;UIListLayout&quot;,content,{Padding=UDim.new(0,9),SortOrder=Enum.SortOrder.LayoutOrder})
local toast=make(&quot;TextLabel&quot;,gui,{AnchorPoint=Vector2.new(.5,1),Position=UDim2.new(.5,0,1,-16),Size=UDim2.new(1,-32,0,72),BackgroundColor3=ink,BackgroundTransparency=.08,TextColor3=white,Font=Enum.Font.GothamMedium,TextSize=16,TextWrapped=true,Visible=false,ZIndex=15})
make(&quot;UISizeConstraint&quot;,toast,{MaxSize=Vector2.new(570,72)})
make(&quot;UIPadding&quot;,toast,{PaddingLeft=UDim.new(0,14),PaddingRight=UDim.new(0,14)})
round(toast)
local toastNumber=0
local function message(text)
    toastNumber=toastNumber+1
    local current=toastNumber
    toast.Text,toast.Visible=text,true
    task.delay(5,function() if current==toastNumber then toast.Visible=false end end)
end
local function clear(title)
    for _,child in ipairs(content:GetChildren()) do if child:IsA(&quot;GuiObject&quot;) then child:Destroy() end end
    heading.Text=title
    content.CanvasPosition=Vector2.zero
    panel.Visible=true
end
local function note(text)
    local label=make(&quot;TextLabel&quot;,content,{Size=UDim2.new(1,-8,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1,Text=text,TextColor3=ink,Font=Enum.Font.Gotham,TextSize=15,TextWrapped=true,TextXAlignment=Enum.TextXAlignment.Left,ZIndex=7})
    make(&quot;UIPadding&quot;,label,{PaddingTop=UDim.new(0,3),PaddingBottom=UDim.new(0,7)})
end
local function button(title,subtitle,callback)
    local b=make(&quot;TextButton&quot;,content,{Size=UDim2.new(1,-8,0,72),Text=&quot;&quot;,BackgroundColor3=Color3.fromRGB(225,235,229),BorderSizePixel=0,ZIndex=7})
    round(b,10)
    make(&quot;TextLabel&quot;,b,{Position=UDim2.fromOffset(12,7),Size=UDim2.new(1,-24,0,25),Text=title,BackgroundTransparency=1,TextColor3=ink,Font=Enum.Font.GothamBold,TextSize=16,TextXAlignment=Enum.TextXAlignment.Left,ZIndex=8})
    make(&quot;TextLabel&quot;,b,{Position=UDim2.fromOffset(12,33),Size=UDim2.new(1,-24,0,34),Text=subtitle or &quot;&quot;,BackgroundTransparency=1,TextColor3=Color3.fromRGB(67,88,93),Font=Enum.Font.Gotham,TextSize=13,TextWrapped=true,TextXAlignment=Enum.TextXAlignment.Left,ZIndex=8})
    b.Activated:Connect(callback)
    return b
end
local function send(kind,id) network.Action:FireServer(kind,id) end
local pages={}
function pages.roles()
    clear(&quot;Kies jouw rol&quot;)
    note(&quot;Alle rollen zijn gratis. Ga voor speelmunten naar de bijbehorende werkplek en blijf daar 8 seconden.&quot;)
    for _,role in ipairs(Config.Roles) do
        button(role.name,role.task,function() send(&quot;role&quot;,role.id); panel.Visible=false end)
    end
end
function pages.travel()
    clear(&quot;Ontdek de regio&quot;)
    note(&quot;Gratis snel reizen. De kaart is een fantasieversie, geen exacte geografische kopie.&quot;)
    for _,place in ipairs(Config.Destinations) do
        button(place.name,place.description,function() send(&quot;travel&quot;,place.id); panel.Visible=false end)
    end
end
function pages.vehicles()
    clear(&quot;Op pad&quot;)
    note(&quot;Ga naar een P-plek bij een halte. Pak een voertuig, loop erheen en kies Instappen. WASD of de rij-knoppen om te rijden.&quot;)
    for _,v in ipairs(Config.Vehicles) do
        button(v.name,&quot;Gratis arcadevoertuig · maximaal één tegelijk&quot;,function() send(&quot;vehicle&quot;,v.id); panel.Visible=false end)
    end
    button(&quot;Voertuig opruimen&quot;,&quot;Maak je parkeerplek vrij&quot;,function() send(&quot;removeVehicle&quot;); panel.Visible=false end)
end
function pages.house()
    clear(&quot;Mijn huis&quot;)
    local house=player:GetAttribute(&quot;House&quot;) or &quot;&quot;
    if house==&quot;&quot; then note(&quot;In Zwanenburg staan zes gratis huizen. Loop naar het bordje GRATIS HUIS en kies Bewonen.&quot;)
    else
        note(&quot;Jouw huis: &quot;..house..&quot;. Huis en kleuren blijven alleen tijdens deze speelsessie bewaard.&quot;)
        button(&quot;Naar huis&quot;,&quot;Je komt buiten bij je voordeur aan&quot;,function() send(&quot;home&quot;); panel.Visible=false end)
        button(&quot;Slot aan / uit&quot;,&quot;Binnen kun je altijd naar buiten&quot;,function() send(&quot;lock&quot;) end)
        for _,theme in ipairs(Config.Themes) do
            local owned=player:GetAttribute(&quot;Theme_&quot;..theme.id)
            button(&quot;Woonstijl: &quot;..theme.name,owned and &quot;In bezit · gratis toepassen&quot; or (theme.price..&quot; speelmunten · GEEN Robux&quot;),function() send(&quot;theme&quot;,theme.id); panel.Visible=false end)
        end
        button(&quot;Huis vrijgeven&quot;,&quot;Klik om te bevestigen in het volgende scherm&quot;,function()
            clear(&quot;Huis vrijgeven?&quot;)
            note(&quot;Je huis wordt direct beschikbaar voor andere spelers. Je kunt daarna een ander vrij huis kiezen.&quot;)
            button(&quot;Ja, geef mijn huis vrij&quot;,&quot;Je speelmunten en vrijgespeelde stijlen blijven in deze sessie behouden&quot;,function() send(&quot;release&quot;); panel.Visible=false end)
            button(&quot;Nee, behouden&quot;,&quot;Terug naar Mijn huis&quot;,pages.house)
        end)
    end
end
for i,item in ipairs({{&quot;Rollen&quot;,&quot;roles&quot;},{&quot;Reizen&quot;,&quot;travel&quot;},{&quot;Voertuigen&quot;,&quot;vehicles&quot;},{&quot;Mijn huis&quot;,&quot;house&quot;}}) do
    local b=make(&quot;TextButton&quot;,nav,{Text=item[1],BackgroundColor3=teal,TextColor3=white,Font=Enum.Font.GothamBold,TextSize=15,BorderSizePixel=0,LayoutOrder=i})
    round(b,10); b.Activated:Connect(pages[item[2]])
end
local function updateStatus()
    status.Text=stats.Munten.Value..&quot; munten  /  &quot;..stats.Rol.Value..(player:GetAttribute(&quot;Working&quot;) and &quot;  /  bezig&quot; or &quot;&quot;)
end
stats.Munten.Changed:Connect(updateStatus)
stats.Rol.Changed:Connect(updateStatus)
player:GetAttributeChangedSignal(&quot;Working&quot;):Connect(updateStatus)
updateStatus()
network.Notice.OnClientEvent:Connect(function(kind,text)
    if kind==&quot;travel&quot; then pages.travel()
    elseif kind==&quot;vehicles&quot; then pages.vehicles()
    elseif type(text)==&quot;string&quot; then message(text) end
end)

-- Explicit touch buttons also work without the default mobile movement stick.
local driving=make(&quot;Frame&quot;,gui,{AnchorPoint=Vector2.new(1,1),Position=UDim2.new(1,-12,1,-96),Size=UDim2.fromOffset(206,142),BackgroundTransparency=1,Visible=false})
local held={}
local bindings={Forward={Enum.KeyCode.W,Enum.KeyCode.Up},Back={Enum.KeyCode.S,Enum.KeyCode.Down},Left={Enum.KeyCode.A,Enum.KeyCode.Left},Right={Enum.KeyCode.D,Enum.KeyCode.Right}}
local function key(actionName,state)
    if UserInputService:GetFocusedTextBox() then return Enum.ContextActionResult.Pass end
    held[actionName]=state==Enum.UserInputState.Begin or state==Enum.UserInputState.Change
    return Enum.ContextActionResult.Sink
end
for _,info in ipairs({{&quot;Forward&quot;,&quot;Vooruit&quot;,70,0},{&quot;Back&quot;,&quot;Achteruit&quot;,70,96},{&quot;Left&quot;,&quot;Links&quot;,0,48},{&quot;Right&quot;,&quot;Rechts&quot;,140,48}}) do
    local b=make(&quot;TextButton&quot;,driving,{Position=UDim2.fromOffset(info[3],info[4]),Size=UDim2.fromOffset(66,42),Text=info[2],TextColor3=white,BackgroundColor3=ink,Font=Enum.Font.GothamBold,TextSize=12})
    round(b,9)
    b.InputBegan:Connect(function(input)
        if input.UserInputType==Enum.UserInputType.Touch or input.UserInputType==Enum.UserInputType.MouseButton1 then
            held[info[1]]=true
            local connection
            connection=input.Changed:Connect(function()
                if input.UserInputState==Enum.UserInputState.End or input.UserInputState==Enum.UserInputState.Cancel then
                    held[info[1]]=false; connection:Disconnect()
                end
            end)
        end
    end)
end
local exitButton=make(&quot;TextButton&quot;,driving,{Position=UDim2.fromOffset(70,48),Size=UDim2.fromOffset(66,42),Text=&quot;Uitstappen&quot;,TextColor3=white,BackgroundColor3=Color3.fromRGB(176,90,67),Font=Enum.Font.GothamBold,TextSize=11})
round(exitButton,9); exitButton.Activated:Connect(function() send(&quot;exit&quot;) end)
local function updateDriving()
    local enabled=player:GetAttribute(&quot;Driving&quot;)==true
    driving.Visible=enabled
    held={}
    for name,keys in pairs(bindings) do
        if enabled then ContextActionService:BindActionAtPriority(name,key,false,3000,table.unpack(keys))
        else ContextActionService:UnbindAction(name) end
    end
end
player:GetAttributeChangedSignal(&quot;Driving&quot;):Connect(updateDriving)
UserInputService.WindowFocusReleased:Connect(function() held={} end)
UserInputService.TextBoxFocused:Connect(function() held={} end)
updateDriving()
local elapsed=0
RunService.Heartbeat:Connect(function(dt)
    elapsed=elapsed+dt
    if elapsed&lt;.1 then return end
    elapsed=0
    if player:GetAttribute(&quot;Driving&quot;) then
        local blocked=panel.Visible or UserInputService:GetFocusedTextBox()~=nil
        local throttle=blocked and 0 or ((held.Forward and 1 or 0)-(held.Back and 1 or 0))
        local steer=blocked and 0 or ((held.Right and 1 or 0)-(held.Left and 1 or 0))
        network.Drive:FireServer(throttle,steer)
    end
end)
task.delay(1,function()
    clear(&quot;Welkom in Holland City&quot;)
    note(&quot;Jouw Nederlandse speelwereld. Kies een huis, fiets door de polder of maak snoep in SweetCity.&quot;)
    note(&quot;E of tik op een actie om iets te gebruiken. Via Reizen kun je altijd gratis naar een ander gebied.&quot;)
    note(&quot;Prototype v0.1: munten, woonstijl en huis worden nog NIET opgeslagen na het verlaten. Er zijn geen Robux-aankopen.&quot;)
    note(&quot;Speel vriendelijk. Gebruik de normale Roblox-functies voor blokkeren en rapporteren. Deze game heeft geen eigen vrije chat of privéberichten.&quot;)
    button(&quot;Begin in Zwanenburg&quot;,&quot;Kies een vrij huis bij een wit huisbordje&quot;,function() panel.Visible=false end)
end)
</ProtectedString></Properties></Item></Item></Item><Item class="TextChatService" referent="RBX1517"><Properties><string name="Name">TextChatService</string><bool name="CreateDefaultTextChannels">true</bool><bool name="CreateDefaultCommands">true</bool><token name="ChatVersion">1</token></Properties></Item></roblox>
